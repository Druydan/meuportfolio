# ============================================================
# .gitignore — Portfólio Vite + React + Firebase
# ============================================================

# ---------------------------
# Variáveis de ambiente (NUNCA commitar segredos!)
# ---------------------------
.env
.env.local
.env.*.local

# ---------------------------
# Dependências do Node.js
# ---------------------------
node_modules/

# ---------------------------
# Build gerado pelo Vite
# ---------------------------
dist/
dist-ssr/

# ---------------------------
# Cache do Vite
# ---------------------------
.vite/

# ---------------------------
# Firebase: cache e logs de deploy
# ---------------------------
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log

# ---------------------------
# Firebase Data Connect (gerado automaticamente)
# ---------------------------
.dataconnect/

# ---------------------------
# Logs gerais
# ---------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------
# Caches de ferramentas
# ---------------------------
.eslintcache
.stylelintcache
.npm
.pnp
.pnp.js

# ---------------------------
# Sistema Operacional
# ---------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------
# IDEs e editores
# ---------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------
# Testes e cobertura
# ---------------------------
coverage/
.nyc_output/

# ---------------------------
# Arquivos temporários
# ---------------------------
*.tgz
*.pid
*.pid.lock
*.seed
lib-cov/
.lock-wscript
build/Release
.yarn-integrity
.node_repl_history
